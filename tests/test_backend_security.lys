Import crypto
Import validation

Set pass to "SecretAdminPassword123!"
Set hashed to crypto.hash_password(pass)
Assert(crypto.verify_password(pass, hashed) is equal to true, "Correct password verified")
Assert(crypto.verify_password("WrongPassword", hashed) is equal to false, "Wrong password rejected")

Set sha to crypto.sha256("lyslyn")
Assert(sha.length is equal to 64, "SHA-256 length is 64 hex characters")

Set tok to crypto.token(16)
Assert(tok.length is equal to 32, "16 bytes token is 32 hex chars")

Set uid to crypto.uuid()
Assert(uid.length is equal to 36, "UUID v4 length is 36 chars")

Set valid_user to {
    "name": "Raj",
    "email": "raj@lyslyn.org",
    "age": 28
}

Set user_schema to {
    "name": "required string min:2",
    "email": "required email",
    "age": "required number min:18"
}

Set val_result to validation.validate(valid_user, user_schema)
Assert(val_result.valid is equal to true, "Valid payload passes validation")

Set invalid_user to {
    "name": "A",
    "email": "not-an-email",
    "age": 16
}

Set fail_result to validation.validate(invalid_user, user_schema)
Assert(fail_result.valid is equal to false, "Invalid payload caught")
Assert(fail_result.errors.length is equal to 3, "All 3 validation errors detected")
