Import db

db.connect(":memory:")

db.create_table("users", {
    "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
    "name": "TEXT NOT NULL",
    "email": "TEXT UNIQUE NOT NULL",
    "role": "TEXT DEFAULT 'user'",
    "active": "INTEGER DEFAULT 1"
})

Assert(db.table_exists("users") is equal to true, "Table users created")

Set user1 to db.insert("users", {
    "name": "Raj",
    "email": "raj@lyslyn.org",
    "role": "admin"
})
Assert(user1.id is equal to 1, "First user ID")
Assert(user1.name is equal to "Raj", "First user name")

Set user2 to db.insert("users", {
    "name": "Alex",
    "email": "alex@lyslyn.org",
    "role": "engineer"
})
Assert(user2.id is equal to 2, "Second user ID")

Set total_users to db.count("users")
Assert(total_users is equal to 2, "Total users count is 2")

Set found to db.find_one("users", {"email": "raj@lyslyn.org"})
Assert(found.name is equal to "Raj", "Find one by email")
Assert(found.role is equal to "admin", "Find one role")

Set rows_updated to db.update("users", {"id": 2}, {"role": "lead_engineer"})
Assert(rows_updated is equal to 1, "Rows updated")

Set updated_user to db.find_one("users", {"id": 2})
Assert(updated_user.role is equal to "lead_engineer", "Updated role check")

Set admins to db.query("SELECT * FROM users WHERE role = ?", ["admin"])
Assert(admins.length is equal to 1, "Admins query count")
Assert(admins[0].name is equal to "Raj", "Admin name")

Set rows_deleted to db.delete("users", {"id": 2})
Assert(rows_deleted is equal to 1, "Rows deleted")
Assert(db.count("users") is equal to 1, "Count after delete is 1")
