{
  "name": "lyslyn-language",
  "displayName": "Lyslyn Language Support",
  "description": "Rich language syntax highlighting and formatting for the Lyslyn programming language.",
  "version": "1.1.0",
  "publisher": "lyslyn",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lyslyn",
        "aliases": ["Lyslyn", "lyslyn"],
        "extensions": [".lys"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lyslyn",
        "scopeName": "source.lyslyn",
        "path": "./syntaxes/lyslyn.tmLanguage.json"
      }
    ]
  }
}
