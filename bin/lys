#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CANDIDATES=(
    "$HOME/.local/bin/lyslyn"
    "$HOME/.cargo_target/lyslyn/release/lyslyn"
    "$REPO_ROOT/target/release/lyslyn"
    "$(command -v lyslyn 2>/dev/null || true)"
)

BIN=""
for c in "${CANDIDATES[@]}"; do
    if [ -n "$c" ] && [ -x "$c" ]; then
        BIN="$c"
        break
    fi
done

if [ -z "$BIN" ]; then
    echo "Error: Lyslyn native binary not found. Please run 'cargo build --release' first." >&2
    exit 1
fi

exec "$BIN" "$@"
