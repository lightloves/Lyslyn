Import files
Import json
Import time

Set db_file to "./tasks_db.json"

Create a function called init_db:
    If not files.exists(db_file):
        Set initial_data to {
            "version": 1,
            "tasks": []
        }
        files.write_text(db_file, json.stringify(initial_data, 2))

Create a function called load_tasks:
    Set raw to files.read_text(db_file)
    Set db to json.parse(raw)
    Return db.tasks

Create a function called save_tasks with tasks_list:
    Set db to {
        "version": 1,
        "tasks": tasks_list
    }
    files.write_text(db_file, json.stringify(db, 2))

Create a function called add_task with title, priority:
    Set tasks to load_tasks()
    Set new_task to {
        "id": tasks.length + 1,
        "title": title,
        "priority": priority,
        "completed": false,
        "created_at": time.now()
    }
    append(tasks, new_task)
    save_tasks(tasks)
    Print "✓ Added task:", title

Create a function called complete_task with task_id:
    Set tasks to load_tasks()
    For each t in tasks:
        If t.id is equal to task_id:
            Set t.completed to true
            save_tasks(tasks)
            Print "✓ Marked task {task_id} as completed!"
            Return true
    Print "✗ Task {task_id} not found."
    Return false

Create a function called list_tasks:
    Set tasks to load_tasks()
    Print "\n==================== TASK LIST ===================="
    If tasks.length is equal to 0:
        Print "  No tasks found. Everything is done!"
    Otherwise:
        For each t in tasks:
            Set status_mark to if t.completed: "[DONE]" Otherwise: "[TODO]"
            Print "  {status_mark} #{t.id}: {t.title} (Priority: {t.priority})"
    Print "===================================================\n"

init_db()

Print "--- Initializing Task System ---"
add_task("Design Lyslyn formal grammar", "High")
add_task("Implement lexer and parser", "High")
add_task("Build virtual machine and interpreter", "High")
add_task("Write comprehensive test suite", "Medium")
add_task("Publish documentation and CLI", "Medium")

list_tasks()

Print "--- Updating Task Progress ---"
complete_task(1)
complete_task(2)
complete_task(3)

list_tasks()

files.delete(db_file)
Print "✓ Demo completed and database cleaned up."
