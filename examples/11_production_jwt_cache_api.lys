# Production backend server with JWT auth, TTL caching, and rate limiting
Import env
Import log
Import jwt
Import cache
Import server
Import crypto
Import collections

# Configuration and environment setup
Set port to env.get_int("PORT", 8080)
Set jwt_secret to env.get("JWT_SECRET", "super-secure-production-secret-key-32b")
log.set_level("info")
log.info("Booting Lyslyn Enterprise Server...", {"port": port, "env": "production"})

# Mock database records with secure password hashing
Set hashed_pw to crypto.hash_password("admin123")
Set users_db to {
    "admin": {
        "id": "usr_001",
        "username": "admin",
        "role": "superadmin",
        "password_hash": hashed_pw
    }
}

Set inventory to [
    {"id": 1, "name": "Server Blade X1", "price": 1200, "category": "hardware", "stock": 15},
    {"id": 2, "name": "Gigabit Switch 48P", "price": 450, "category": "networking", "stock": 4},
    {"id": 3, "name": "SFP+ Optical Transceiver", "price": 85, "category": "networking", "stock": 80},
    {"id": 4, "name": "NVMe U.2 Enterprise SSD 7.68TB", "price": 890, "category": "storage", "stock": 0},
    {"id": 5, "name": "UPS Backup Power Unit 3000VA", "price": 950, "category": "power", "stock": 6}
]

# Launch server with enterprise middleware pipeline
Serve HTTP on port port:

    Use middleware server.cors("*")
    Use middleware server.logger()
    Use middleware server.rate_limit(100, 60)
    Use middleware server.jwt_auth(jwt_secret, ["/health", "/api/auth/login", "/api/catalog"])

    # Health check route
    Route GET "/health":
        Respond with status 200 and json {
            "status": "healthy",
            "uptime_seconds": 120,
            "cache_size": cache.size()
        }

    # Authentication route generating signed JWT token
    Route POST "/api/auth/login":
        Validate body with {
            "username": "required string",
            "password": "required string min:6"
        }

        Set user to users_db[request.body.username]
        If user is nil:
            log.warn("Login attempt with unknown username", {"user": request.body.username})
            Respond with status 401 and json {"error": "Invalid credentials"}

        Set valid to crypto.verify_password(request.body.password, user.password_hash)
        If not valid:
            log.warn("Invalid password attempt", {"user": request.body.username})
            Respond with status 401 and json {"error": "Invalid credentials"}

        Set token_claims to {
            "sub": user.id,
            "user": user.username,
            "role": user.role
        }
        Set auth_token to jwt.sign(token_claims, jwt_secret, 7200)

        log.info("User successfully logged in", {"user": user.username})
        Respond with status 200 and json {
            "token": auth_token,
            "token_type": "Bearer",
            "expires_in": 7200,
            "user": {
                "id": user.id,
                "username": user.username,
                "role": user.role
            }
        }

    # Protected profile endpoint using JWT claims from request.user
    Route GET "/api/me":
        Respond with status 200 and json {
            "authenticated": true,
            "claims": request.user
        }

    # Public catalog endpoint with TTL cache fallback
    Route GET "/api/catalog":
        Set cached_catalog to cache.get("catalog:available")
        If cached_catalog is not nil:
            Respond with status 200 and json {
                "source": "cache",
                "items": cached_catalog
            }

        Create a function called in_stock with item:
            Return item.stock > 0

        Set available_items to Filter(inventory, in_stock)

        # Cache available items for 30 seconds
        cache.set("catalog:available", available_items, 30)

        Respond with status 200 and json {
            "source": "database",
            "count": Length(available_items),
            "items": available_items
        }

    # Role-restricted admin endpoint to purge cache
    Route POST "/api/admin/cache/clear":
        If request.user.role does not equal "superadmin":
            Respond with status 403 and json {"error": "Forbidden: superadmin required"}

        cache.clear()
        log.info("Admin cleared application cache", {"by": request.user.user})
        Respond with status 200 and json {"message": "Cache successfully cleared"}
